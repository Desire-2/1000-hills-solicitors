# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-very-secure-secret-key-change-this
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-change-this

# Database Configuration
DB_PASSWORD=your-secure-database-password
DATABASE_URL=postgresql://legal_cms_user:your-secure-database-password@db:5432/legal_cms

# Frontend URL (for CORS - where your frontend is deployed)
FRONTEND_URL=https://1000-hills-solicitors.vercel.app

# CORS Origins (comma-separated list of allowed origins for CORS)
# Should match your deployed frontend and any other allowed origins
CORS_ORIGINS=https://1000-hills-solicitors.vercel.app,http://localhost:3000,http://localhost:3001

# Server Configuration
PORT=5000
HOST=0.0.0.0
